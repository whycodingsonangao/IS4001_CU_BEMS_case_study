# ---- Data (never commit raw or derived data; it is ~700 MB) ----
data/raw/*
data/processed/*
data/external/*
!data/**/.gitkeep
*.csv
*.parquet
*.feather
*.h5
*.pkl
*.joblib
# Allow small hand-made reference tables if you need them:
!references/**/*.csv

# ---- Local research ----
local_research/

# ---- Python ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---- Streamlit ----
.streamlit/secrets.toml

# ---- Secrets / local config ----
.env
.env.*
!.env.example

# ---- OS / editors ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
~$*
